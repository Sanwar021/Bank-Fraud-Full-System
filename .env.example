# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
APP_ENV=development
APP_NAME="Bank Investigation"

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bank_investigation
DB_SSLMODE=disable

# Cache / Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication (JWT)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
EXPOSE_DEMO_CODES=false
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ML Fraud Detection Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=replace-with-a-separate-random-service-secret
ML_ALLOWED_ORIGINS=http://localhost:3002
ML_INFERENCE_TIMEOUT_MS=150
FRAUD_LOW_THRESHOLD=30.0
FRAUD_HIGH_THRESHOLD=70.0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

